# Copy to .env.local and fill in. Never commit .env.local.
# Production/preview values are set in Vercel (Project → Settings → Environment Variables).

# ── Supabase (public — safe in the browser; access is limited by RLS) ───────
# Local development: printed by `npm run db:start` (API_URL and PUBLISHABLE_KEY).
# Hosted project: Supabase dashboard → Project Settings → API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
